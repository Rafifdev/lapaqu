    {
      "name": "Fase 4: Transaksi & Realtime",
      "item": [
        {
          "name": "1. Public Resolve Meja & Menu (Customer Scan QR)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/public/tables/{{demo_table_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "tables",
                "{{demo_table_token}}"
              ]
            }
          }
        },
        {
          "name": "2. Customer Buat Pesanan (Self-Order Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.order && jsonData.order.id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.order.id);",
                  "    console.log('Saved order_id:', jsonData.order.id);",
                  "}",
                  "if (jsonData.payment && jsonData.payment.id) {",
                  "    pm.collectionVariables.set('payment_id', jsonData.payment.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_token\": \"qr_senopati_01\",\n  \"customer_name\": \"Dimas Postman\",\n  \"customer_phone\": \"081234567890\",\n  \"notes\": \"Jangan pakai sedotan plastik\",\n  \"items\": [\n    {\n      \"menu_item_id\": \"REPLACE_WITH_MENU_ITEM_ID\",\n      \"quantity\": 2,\n      \"notes\": \"Less sugar\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/public/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "orders"
              ]
            }
          }
        },
        {
          "name": "3. Customer Polling Status Pesanan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/public/orders/{{order_id}}/status",
